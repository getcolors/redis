#!/usr/bin/env bb
;; Redis launcher — one Redis 7.2 server on one Vultr instance or DigitalOcean
;; droplet, published on loopback only, reached over an SSH tunnel, with RDB
;; backup sets in Cloudflare R2.
;;
;; Desired state lives in colors.yml. Secrets are supplied only through
;; COLORS_PAR_* environment variables. COLORS_PAR_PROFILE is always refused.
;; Lifecycle logic lives in the tested redis library, not in this copied file.
;; REDIS_LIB_ROOT, GREEN_LIB_ROOT and ONCE_LIB_ROOT override the immutable
;; dependencies with working trees.

(require '[babashka.fs :as fs]
         '[clojure.java.io :as io]
         '[clojure.string :as str])

(def script-dir
  (let [file (if (= "NO_SOURCE_PATH" *file*)
               (fs/path (fs/cwd) "green")
               (fs/path *file*))]
    (str (fs/parent (fs/canonicalize file)))))

(def ^:private launcher-contract 1)

;; Managed by `bb pin` — do not edit by hand. An initial nil is intentional:
;; the repository must be committed and pushed before a real SHA can be stamped.
(def ^:private redis-sha "537858307ee85f90b28813a272f0d26b9b4b07a8")

(def ^:private redis-git-url "https://github.com/getcolors/redis.git")
(def ^:private green-git-url "https://github.com/getcolors/green.git")
(def ^:private once-git-url "https://github.com/getcolors/once.git")

(defn- lib-coord [env-var url sha deps-root]
  (if-let [root (System/getenv env-var)]
    {:local/root (if deps-root (str (io/file root deps-root)) root)}
    (when sha
      (cond-> {:git/url url :git/sha sha}
        deps-root (assoc :deps/root deps-root)))))

(def ^:private resolved?
  (some? (io/resource "io/github/getcolors/redis/tools.clj")))

(def ^:private bootstrap-error
  (when (and (System/getProperty "babashka.version") (not resolved?))
    (let [redis (lib-coord "REDIS_LIB_ROOT" redis-git-url redis-sha nil)
          green (lib-coord "GREEN_LIB_ROOT" green-git-url nil nil)
          once (lib-coord "ONCE_LIB_ROOT" once-git-url nil "green")]
      (if-not redis
        (str "this launcher carries no redis pin.\n"
             "It has not been stamped by `bb pin`, which cannot run until the "
             "redis repository has been pushed.\n"
             "Point it at a checkout meanwhile: REDIS_LIB_ROOT=/path/to/redis")
        (do ((requiring-resolve 'babashka.deps/add-deps)
             {:deps (cond-> {'io.github.getcolors/redis redis}
                      green (assoc 'io.github.getcolors/green green)
                      once (assoc 'io.github.getcolors/once once))})
            nil)))))

(def ^:private load-error
  (or bootstrap-error
      (try
        (require 'green.cli 'io.github.getcolors.redis.workflow)
        nil
        (catch Throwable t (or (ex-message t) (str (class t)))))))

(defn- redis-contract []
  (or (some-> (requiring-resolve 'io.github.getcolors.redis.utils/contract) deref)
      0))

(defn- contract-error []
  (let [resolved (if load-error 0 (redis-contract))]
    (when (< resolved launcher-contract)
      {:green/exit 2
       :green/err (str "this launcher requires redis contract " launcher-contract
                       " but resolved " resolved "\n"
                       (if redis-sha
                         (str "the pinned commit " (apply str (take 7 redis-sha))
                              " predates this launcher; update the skill or repin")
                         "no redis library could be resolved")
                       (when load-error (str "\n" load-error)))})))

(defn- find-up [name dir]
  (loop [dir (.getAbsoluteFile (io/file dir))]
    (when dir
      (let [candidate (io/file dir name)]
        (if (.exists candidate)
          (str candidate)
          (recur (.getParentFile dir)))))))

(defn- default-file []
  (or (find-up "colors.yml" ".")
      (let [beside-script (io/file script-dir "colors.yml")]
        (when (.exists beside-script) (str beside-script)))
      "colors.yml"))

(defn- file-arg? [arg]
  (or (= "-f" arg) (= "--file" arg)
      (str/starts-with? (str arg) "--file=")))

(defn default-args [args]
  (let [args (vec args)]
    (cond-> args
      (not-any? file-arg? args) (conj "-f" (default-file)))))

(def lifecycle-commands #{"build" "create" "delete" "rehearse" "describe"})

(def usage
  (str "Usage: green <build|create|delete|rehearse|describe> "
       "[-f|--file colors.yml] [--dry-run]\n"
       "\n"
       "  build     render the work directory only — contact nothing\n"
       "  create    provision the machine, converge Redis, run the gates\n"
       "  delete    explicitly remove the SSH alias, the machine and its keypair\n"
       "  rehearse  take a backup set, restore it into a scratch instance, read it back\n"
       "  describe  read the host's last monitor result over SSH"))

(defn run [& args]
  (let [args (vec args)
        command (first args)]
    (cond
      (contains? #{"help" "--help" "-h"} command)
      {:green/exit 0 :green/err usage}

      (contains? lifecycle-commands command)
      (or (contract-error)
          ((requiring-resolve 'green.cli/run-cli)
           @(requiring-resolve 'io.github.getcolors.redis.workflow/workflow)
           (default-args args)))

      :else {:green/exit 2 :green/err usage})))

(defn -main [& args]
  (let [{:green/keys [exit err trace]} (apply run args)]
    (when err
      (binding [*out* (if (zero? (or exit 0)) *out* *err*)]
        (println err)
        (when trace (println trace))))
    (System/exit (or exit 0))))

(defn- launched-as-script? []
  (when-let [bb-file (System/getProperty "babashka.file")]
    (= (str (fs/canonicalize bb-file))
       (str (fs/canonicalize *file*)))))

(when (launched-as-script?)
  (apply -main *command-line-args*))
