{:paths ["test/clj" "test/resources"]
 :deps {io.github.getcolors/redis {:local/root "."}}
 :tasks
 {test {:doc "Run unit tests under Babashka"
        :requires ([clojure.test :as t]
                   [io.github.getcolors.redis.validate-test]
                   [io.github.getcolors.redis.ssh-test]
                   [io.github.getcolors.redis.ssh-config-test]
                   [io.github.getcolors.redis.tools-test]
                   [io.github.getcolors.redis.workflow-test])
        :task (let [{:keys [fail error]}
                    (t/run-tests 'io.github.getcolors.redis.validate-test
                                 'io.github.getcolors.redis.ssh-test
                                 'io.github.getcolors.redis.ssh-config-test
                                 'io.github.getcolors.redis.tools-test
                                 'io.github.getcolors.redis.workflow-test)]
                (System/exit (if (pos? (+ fail error)) 1 0)))}
  golden {:doc "Render and diff committed golden output"
          :task (shell "./scripts/golden.sh")}
  golden:accept {:doc "Regenerate goldens after inspecting a fresh render"
                 :task (shell "./scripts/golden.sh" "--accept")}
  syntax {:doc "Offline ansible-playbook --syntax-check and bash -n on the rendered tree"
          :task (shell "./scripts/syntax.sh")}
  pin {:doc "Stamp the launcher after a clean pushed commit"
       :task (load-file "tasks/pin.clj")}}}
